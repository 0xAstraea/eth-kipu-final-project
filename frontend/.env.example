# Target chain: 31337 (localhost/hardhat) or 11155111 (Sepolia)
NEXT_PUBLIC_CHAIN_ID=31337

# JSON-RPC endpoint. Defaults to http://127.0.0.1:8545 for localhost.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Addresses printed by contracts/deploy/deploy.ts.
# For localhost, read them from contracts/deployments/localhost.json.
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_CREDENTIAL_ADDRESS=
NEXT_PUBLIC_SEMAPHORE_ADDRESS=

# First block to scan for events. Leave 0 for a fresh localhost deploy.
NEXT_PUBLIC_FROM_BLOCK=0
