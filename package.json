{
  "name": "teamup-zk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "description": "TeamUp ZK - anonymous team formation protocol using Semaphore zero-knowledge membership proofs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "pnpm run test:contracts && pnpm run test:frontend",
    "test:contracts": "hardhat test",
    "test:frontend": "pnpm --filter @teamup/frontend test",
    "coverage": "hardhat test --coverage",
    "typecheck": "tsc --noEmit && pnpm --filter @teamup/frontend typecheck",
    "lint": "pnpm --filter @teamup/frontend lint",
    "build": "pnpm run compile && pnpm --filter @teamup/frontend build",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "dev": "pnpm --filter @teamup/frontend dev",
    "node": "hardhat node",
    "demo": "hardhat run scripts/demo.ts",
    "smoke": "hardhat run scripts/00-smoke.ts",
    "deploy:localhost": "hardhat run deploy/deploy.ts --network localhost",
    "interact:localhost": "hardhat run deploy/interact.ts --network localhost",
    "deploy:sepolia": "hardhat run deploy/deploy.ts --network sepolia",
    "interact:sepolia": "hardhat run deploy/interact.ts --network sepolia",
    "verify:sepolia": "hardhat run deploy/verify.ts --network sepolia",
    "verify:deps": "hardhat run deploy/verify-deps-etherscan.ts --network sepolia",
    "verify:localhost": "hardhat run deploy/verify.ts --network localhost",
    "export:abis": "node scripts/export-abis.mjs",
    "sync:frontend-env": "node scripts/sync-frontend-env.mjs",
    "gas": "bash scripts/gas-run.sh applied"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@zk-kit/lean-imt.sol": "^2.0.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "hardhat": "^3.19.0",
    "poseidon-solidity": "^0.0.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@semaphore-protocol/contracts": "^4.14.3",
    "@semaphore-protocol/group": "^4.14.3",
    "@semaphore-protocol/identity": "^4.14.3",
    "@semaphore-protocol/proof": "^4.14.3",
    "chai": "^6.3.0",
    "ethers": "^6.17.0"
  }
}
